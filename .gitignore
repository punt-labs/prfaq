*.aux
*.log
*.out
*.toc
*.synctex.gz
*.bbl
*.bcf
*.blg
*.run.xml
*.fls
*.fdb_latexmk
.DS_Store

# Runtime / scratch
.tmp/
.tts/

# Binary assets (voice auditions, etc.)
research/spike-voices/

# Claude Code (settings.json is tracked; everything else is local/runtime)
# Must be .claude/* — git cannot re-include a file inside an excluded directory,
# so `.claude/` here would make the negation below dead and force `git add -f`.
.claude/*
!.claude/settings.json

# Local-only files (machine-specific, per-user)
*.local
*.local.*

# Vox cached audio
.vox/*.mp3

# Punt Labs tooling state. Claude Code clones this repo onto every consumer's
# machine when they install the plugin, so whatever is tracked here lands in a
# stranger's ~/.claude/. `.punt-labs/` is where vox, lux, biff, quarry, beads,
# and ethos each deposit per-repo state — internal relay URLs, agent rosters,
# session captures — none of which should ship. It also held the `.punt-labs/
# ethos` submodule, whose `git@github.com:` URL aborted `--recurse-submodules`
# for anyone without a GitHub SSH key; ignoring the mount path keeps a stray
# `git submodule add` from putting it back.
#
# Must be .punt-labs/* — git cannot re-include a file inside an excluded
# directory, so `.punt-labs/` here would make the negation below dead.
# ethos.yaml is the exception: two lines naming this repo's agent and team,
# read by the ethos CLI, which resolves the roster itself from the global
# ~/.punt-labs/ethos/ at runtime.
.punt-labs/*
!.punt-labs/ethos.yaml

# The mandated sibling lock every punt CLI takes before mutating a shared
# host file (tool-enable-disable.md 2.4). Per-machine runtime state, and it
# persists by design — unlinking a lock file races the next writer. The
# pattern is broad because the lock's name is the host file's, and tools
# differ on the suffix — .CLAUDE.md.lock and .CLAUDE.md.punt-import.lock
# both appear.
.*.lock
